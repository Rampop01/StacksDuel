{
  "name": "stacksduel-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "sdk"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
